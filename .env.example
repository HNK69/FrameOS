# Required before account setup. Generate a unique random value of at least 32 bytes.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Local SQLite default. Set DATABASE_URL to PostgreSQL for a shared deployment.
DATABASE_URL=sqlite:///./frameops.db

# Groq structured extraction. Set GROQ_MODEL to a model enabled for your actual API account.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hindsight Cloud or compatible deployment. Use the endpoint and token issued to your account.
HINDSIGHT_API_URL=https://inference.hindsight.vectorize.io
HINDSIGHT_API_TOKEN=your-hindsight-api-token-here
HINDSIGHT_RERANK_MODEL=hs-decide-1-flash

# OpenClaw Gateway and CLI. Install/configure OpenClaw separately; no service is bundled.
OPENCLAW_GATEWAY_URL=
OPENCLAW_AUTH_TOKEN=
OPENCLAW_AGENT_ID=main
# Optional absolute path if `openclaw` is not on PATH (Windows npm install: openclaw.cmd):
OPENCLAW_BIN=
OPENCLAW_NODE_BIN=

# Upload development defaults. Use an S3-compatible provider before production.
UPLOAD_DIR=../storage/uploads
MAX_UPLOAD_BYTES=26214400

# Local Docker Compose only. Use a managed secret store in production.
POSTGRES_PASSWORD=replace-with-a-local-development-password
NEXT_PUBLIC_API_URL=http://localhost:8000
